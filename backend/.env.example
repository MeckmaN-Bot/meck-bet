# Copy this to .env and fill in your values

# Get free API key at https://the-odds-api.com (500 requests/month free)
ODDS_API_KEY=your_api_key_here

# Adjust poll frequency (lower = more API usage)
POLL_INTERVAL_MINUTES=5

# Minimum EV% to surface a bet (0.02 = 2% edge)
MIN_EV_THRESHOLD=0.02

# Kelly fraction (0.25 = Quarter Kelly, safest)
KELLY_FRACTION=0.25

# Default bankroll in your currency
DEFAULT_BANKROLL=1000.0
