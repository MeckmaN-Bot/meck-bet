# Meck-Bet Configuration
# Copy this file to .env and fill in your values
# Or run: python3 setup.py (interactive wizard)

# ── The Odds API ──────────────────────────────────────────────────────────────
# Get free key at https://the-odds-api.com (500 requests/month)
ODDS_API_KEY=YOUR_KEY_HERE

# ── Bankroll ──────────────────────────────────────────────────────────────────
# Simulated bankroll for stake sizing (no real money)
DEFAULT_BANKROLL=1000.0

# ── NBA Daily Simulation ──────────────────────────────────────────────────────
DAILY_PICKS=5
MIN_MODEL_CONFIDENCE=0.40

# ── Betting Parameters ────────────────────────────────────────────────────────
# Kelly fraction: 0.25 = Quarter Kelly (conservative, recommended)
KELLY_FRACTION=0.25
# Minimum EV% to consider a bet (0.02 = 2%)
MIN_EV_THRESHOLD=0.02

# ── Polling ───────────────────────────────────────────────────────────────────
# How often to refresh odds (minutes). Lower = more API usage.
POLL_INTERVAL_MINUTES=10

# ── Server ────────────────────────────────────────────────────────────────────
# Port for the backend (uvicorn). Change if 8000 is taken by another service.
PORT=8000
# Bind address — 0.0.0.0 listens on all interfaces
HOST=0.0.0.0
# Full public URL used by the frontend and shown in the summary.
# Set to http://YOUR_SERVER_IP:PORT or https://yourdomain.com
PUBLIC_URL=http://localhost:8000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Allowed request origins. Use * to allow all (convenient for local use).
# For production set specific origins, e.g.:
#   CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=*
